msgstr "Der Satz ist in Welt A falsch und in Welt B wahr."

#: src/worker/exercises/world/strings.ts
msgid "The sentence is false in world A."
msgstr "Der Satz ist in Welt A falsch."

#: src/worker/exercises/world/strings.ts
msgid "The sentence is true in world A and false in world B."
msgstr "Der Satz ist in Welt A wahr und in Welt B falsch."

#: src/worker/exercises/world/strings.ts
msgid "The sentence is true in world B."
msgstr "Der Satz ist in Welt B wahr."

