msgstr "{exercise} — {reason}"

#: src/worker/exercises/model/strings.ts
msgid "{field} of {argument}"
msgstr "{field} von {argument}"

#: src/worker/exercises/model/strings.ts
msgid "{field}: its truth value"
msgstr "{field}: Wahrheitswert"

#: src/worker/exercises/model/strings.ts
msgid "{field}: the tuples in its extension"
msgstr "{field}: die Tupel der Extension"

#: src/worker/exercises/model/strings.ts
