msgstr "{formula}: von nichts erfüllt."

#: src/worker/exercises/world/strings.ts
msgid "{formula}: true."
msgstr "{formula}: wahr."

#: src/worker/exercises/world/strings.ts
msgid "{formula}: witnesses {objects}, and others: {count} in all."
msgstr "{formula}: Zeugen {objects} und weitere, insgesamt {count}."

