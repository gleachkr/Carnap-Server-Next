msgstr "{block} hat jetzt keinen Namen."

#: src/worker/exercises/world/strings.ts
msgid "{block} is now a {kind}."
msgstr "{block} ist jetzt ein {kind}."

#: src/worker/exercises/world/strings.ts
msgid "{block} is now named {names}."
msgstr "{block} heißt jetzt {names}."

#: src/worker/exercises/world/strings.ts
msgid "{block} is pinned and cannot be changed."
msgstr "{block} ist fixiert und kann nicht geändert werden."

