#: src/worker/web/assignments.tsx
msgid "—/{worth} (not released)"
msgstr "—/{worth} (nicht freigegeben)"

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{chunk}” is not part of this language."
msgstr "„{chunk}“ gehört nicht zu dieser Sprache."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{construct}” is not something this exercise type can interpret."
msgstr "„{construct}“ kann dieser Übungstyp nicht interpretieren."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{formula}” has free variables, and a tree's root may have none."
msgstr "„{formula}“ hat freie Variablen, und die Wurzel eines Baums darf keine haben."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{formula}” has free variables, and a world exercise's sentences must have none."
msgstr "„{formula}“ hat freie Variablen, und die Sätze einer Welt-Aufgabe dürfen keine haben."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{formula}” is not propositional; a prop translation uses sentence letters and connectives only."
msgstr "„{formula}“ ist nicht aussagenlogisch; eine prop-Übersetzung verwendet nur Satzbuchstaben und Junktoren."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{inner}” and “{outer}” cannot be combined without parentheses."
msgstr "„{inner}“ und „{outer}“ können ohne Klammern nicht verbunden werden."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{inner}” needs parentheses inside “{outer}”."
msgstr "„{inner}“ braucht Klammern innerhalb von „{outer}“."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{key}” is not a line a world exercise reads. It reads {keys}."
msgstr "„{key}“ ist keine Zeile, die eine Welt-Aufgabe liest. Sie liest {keys}."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{name}” is a free variable; every formula must be a sentence."
msgstr "„{name}“ ist eine freie Variable; jede Formel muss ein Satz sein."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{name}” is not a name in this language."
msgstr "„{name}“ ist kein Name dieser Sprache."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{name}” names two objects."
msgstr "„{name}“ benennt zwei Objekte."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{object}” does not read as an object. Write it like “large cube at 3,5 named a, b”."
msgstr "„{object}“ lässt sich nicht als Objekt lesen. Schreiben Sie es wie „large cube at 3,5 named a, b“."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{operator}” cannot be chained; add parentheses to group it."
msgstr "„{operator}“ kann nicht verkettet werden; setzen Sie Klammern, um die Gruppierung anzugeben."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{path}” is not a path this site serves. A theory kept somewhere else is not supported yet."
msgstr "„{path}“ ist kein Pfad, den diese Website bereitstellt. Eine anderswo gespeicherte Theorie wird noch nicht unterstützt."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{symbol}” has the role “{role}” but does not take individuals as its arguments."
msgstr "„{symbol}“ hat die Rolle „{role}“, nimmt aber keine Individuen als Argumente."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{symbol}” with {arity} arguments has no meaning in a {world} world. Give it one of the world's roles in the language, or leave it out."
msgstr "„{symbol}“ mit {arity} Argumenten hat in einer {world}-Welt keine Bedeutung. Geben Sie ihm in der Sprache eine Rolle der Welt oder lassen Sie es weg."

#: src/worker/application/content/diagnostic-strings.ts
#: src/worker/logic/specs/strings.ts
msgid "“{token}” binds too loosely here; parenthesize it."
msgstr "„{token}“ bindet hier zu schwach; setzen Sie es in Klammern."

#: src/worker/exercises/aufbau-proof-fitch/strings.ts
msgid "“{token}” is not a line number or a subproof range like “a-b”."
msgstr "„{token}“ ist weder eine Zeilennummer noch ein Teilbeweisbereich der Form „a-b“."

#: src/worker/web/ui-strings.ts
msgid "“{token}” is not declared — if it is a variable or a name, bind it in the theorem"
msgstr "„{token}“ ist nicht deklariert – falls es eine Variable oder ein Name ist, binden Sie es im Theorem"

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{value}” is not something “{field}” can contain."
msgstr "„{value}“ ist kein möglicher Wert für „{field}“."

#: src/worker/application/content/diagnostic-strings.ts
msgid "“{word}” is not a shape or size this world knows."
msgstr "„{word}“ ist keine Form oder Größe, die diese Welt kennt."

#: src/worker/exercises/world/strings.ts
msgid "{block} at column {col}, row {row}"
msgstr "{block} in Spalte {col}, Zeile {row}"

#: src/worker/exercises/world/strings.ts
msgid "{block} at column {col}, row {row}, named {names}"
msgstr "{block} in Spalte {col}, Zeile {row}, mit dem Namen {names}"

