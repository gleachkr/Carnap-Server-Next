#: src/worker/application/content/diagnostic-strings.ts
msgid "A “-- label:” comment must sit at the end of the proof line it marks, not on its own line."
msgstr "Ein „-- label:“-Kommentar muss am Ende der Beweiszeile stehen, die er markiert, nicht in einer eigenen Zeile."

#: src/worker/exercises/aufbau-proof-fitch/strings.ts
msgid "A cited subproof must begin and end at the same indentation level."
msgstr "Ein zitierter Teilbeweis muss auf derselben Einrückungsebene beginnen und enden."

#: src/worker/exercises/aufbau-proof-fitch/strings.ts
msgid "A cited subproof must not reach back out to a shallower line."
msgstr "Ein zitierter Teilbeweis darf nicht auf eine weniger eingerückte Zeile zurückgreifen."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A constraint exercise has only givens after its constraint line."
msgstr "In einer Bedingungsaufgabe dürfen nach der Bedingungszeile nur Vorgaben stehen."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A constraint exercise needs a '- constraints : formulas' list item, e.g. '- ExEy~x = y : AxAyF(x,y)'."
msgstr "Eine Bedingungsaufgabe braucht einen Listenpunkt der Form '- Bedingungen : Formeln', z. B. '- ExEy~x = y : AxAyF(x,y)'."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A constraint exercise needs at least one constraint before the ':'."
msgstr "Eine Bedingungsaufgabe braucht mindestens eine Bedingung vor dem ':'."

#: src/worker/application/courses.ts
msgid "A course must keep at least one active instructor."
msgstr "Ein Kurs muss mindestens eine aktive Lehrperson behalten."

#: src/worker/exercises/model/strings.ts
msgid "A domain may have at most {max} elements."
msgstr "Ein Individuenbereich darf höchstens {max} Elemente haben."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A given cell must be T, F, or '.'."
msgstr "Eine vorgegebene Zelle muss T, F oder '.' sein."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A given is written '| Field : value'."
msgstr "Eine Vorgabe wird als '| Feld : Wert' geschrieben."

#: src/worker/application/content/diagnostic-strings.ts
msgid "A given row needs {expected} '|'-separated segments (reference plus one per formula); found {found}."
msgstr "Eine vorgegebene Zeile braucht {expected} durch '|' getrennte Abschnitte (Referenz plus einen pro Formel); gefunden: {found}."

