{
  // Tests that drive a client element in jsdom. They are browser code — DOM lib,
  // no workers-types — plus `bun:test` and the jsdom types, which is why they
  // cannot live in either of the other two programs: the worker program's
  // `Element` is HTMLRewriter's and clashes with every DOM interface a widget
  // uses, and `tsconfig.client.json` deliberately has no ambient types at all so
  // that shipped browser code cannot reach for a Node or Bun global.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun-types"]
  },
  // The client's ambient declarations as well as the tests: a test reaches its
  // subject by import, which drags the client module in but not the `declare
  // module` files it depends on — those are only ever *included*, never
  // imported. Without them an untyped npm package (`@aufbau/compiler`) is an
  // implicit `any` here and a typed module over there, in the same source file.
  "include": ["src/client/**/*.d.ts", "tests/dom/**/*.ts"],
  "exclude": []
}
