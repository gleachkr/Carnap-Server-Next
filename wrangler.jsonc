{
  // Local development, and the template for a deployment of your own.
  //
  // `bun run dev` reads this file as it stands: a local D1 under .wrangler/
  // and CARNAP_ENV=local, which lets a login token come back in the response
  // so you can sign in without an email sender.
  //
  // To deploy an instance, copy this file to wrangler.<yours>.jsonc (that
  // pattern is gitignored, so upgrades never conflict with your settings)
  // and, in the copy:
  //   - set `name` — it becomes the worker's name and its workers.dev host;
  //   - replace `d1_databases` with the database `wrangler d1 create` gives
  //     you, keeping the `DB` binding and `migrations_dir`;
  //   - set CARNAP_ENV to anything but "local", and AUTH_LOGIN_EMAIL_FROM to
  //     the address login mail is sent from.
  // Secrets (the email API key, LTI keys, ADMIN_BOOTSTRAP_TOKEN) are set with
  // `wrangler secret put`, never written here. Then every command takes the
  // copy: `wrangler deploy -c wrangler.<yours>.jsonc`, and
  // `bun run db:migrate:remote -- -c wrangler.<yours>.jsonc` to apply
  // migrations to its database. docs/self-hosting.md has the rest.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnap-server",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  // Built client bundles (bun run build:client). Requests matching a file in
  // here are served statically; everything else falls through to the worker.
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    // The grade-passback outbox sweep. Most sends happen seconds after the
    // score changes (kicked from the request); this catches retries and
    // anything the kick missed.
    "crons": ["*/5 * * * *"]
  },
  // Workers Logs. Without this block the structured console lines —
  // request_failed 500s with their requestId, lti_grade_passback_failed,
  // lti_tool_key_invalid — exist only for whoever happens to be running
  // `wrangler tail` at that moment. With it they land in the dashboard
  // (Workers & Pages → the worker → Logs), queryable after the fact.
  //
  // The log-review habit: after each teaching day, open that view, filter to
  // error level, and search for the three event names above. Retention is
  // Cloudflare's — three days on the free plan, seven on paid — so "after
  // the fact" means days, not weeks; a report of last month's failure finds
  // nothing.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnap-server-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/worker/infrastructure/database/migrations"
    }
  ],
  "vars": {
    "CARNAP_ENV": "local"
  }
}
