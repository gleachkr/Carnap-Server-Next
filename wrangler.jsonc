{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnap-server",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  // Built client bundles (bun run build:client). Requests matching a file in
  // here are served statically; everything else falls through to the worker.
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    // The grade-passback outbox sweep. Most sends happen seconds after the
    // score changes (kicked from the request); this catches retries and
    // anything the kick missed.
    "crons": ["*/5 * * * *"]
  },
  // Workers Logs. Without this block the structured console lines —
  // request_failed 500s with their requestId, lti_grade_passback_failed,
  // lti_tool_key_invalid — exist only for whoever happens to be running
  // `wrangler tail` at that moment. With it they land in the dashboard
  // (Workers & Pages → the worker → Logs), queryable after the fact.
  //
  // The pilot's log-review habit: after each teaching day, open that view,
  // filter to error level, and search for the three event names above.
  // Retention is Cloudflare's — three days on the free plan, seven on paid —
  // so "after the fact" means days, not weeks; a report of last month's
  // failure finds nothing.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnap-server-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/worker/infrastructure/database/migrations"
    }
  ],
  "vars": {
    "CARNAP_ENV": "local"
  },
  "env": {
    "preview": {
      "vars": {
        "CARNAP_ENV": "preview"
      }
    },
    "demo": {
      // Named environments do NOT inherit top-level bindings, so the demo
      // deploy repeats assets/d1/triggers/observability here. Deploy with
      // `wrangler deploy --env demo`. The env name makes the worker
      // carnap-server-demo.<subdomain>.workers.dev (honest "this is a demo"
      // URL). CARNAP_ENV is any non-"local" value → production behaviour
      // (login tokens only ever leave by email; cookies follow the request's
      // protocol whatever the value).
      "vars": {
        "CARNAP_ENV": "demo",
        "AUTH_LOGIN_EMAIL_FROM": "noreply@grahamlk.me"
      },
      "assets": {
        "directory": "./public"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "carnap-server-demo",
          "database_id": "bb6bb092-dbc4-453c-871b-475c7f93bb9f",
          "migrations_dir": "src/worker/infrastructure/database/migrations"
        }
      ]
    }
  }
}
