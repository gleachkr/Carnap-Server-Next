{
  "name": "carnap-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "a11y:audit": "bun scripts/a11y-audit.mjs",
    "a11y:audit:dark": "bun scripts/a11y-audit.mjs --dark",
    "a11y:audit:report": "bun scripts/a11y-audit.mjs --report",
    "a11y:baseline": "bun scripts/a11y-report.ts --update",
    "a11y:report": "bun scripts/a11y-report.ts",
    "build:client": "rm -rf public/assets && bun build src/client/editor-preview.ts src/client/source-view.ts --outdir public/assets --target browser --minify && bun build src/client/components/carnap-*.ts src/client/components/carnap-*.tsx --outdir public/assets/components --target browser --minify --splitting --format esm && cp node_modules/@aufbau/compiler/compiler.wasm public/assets/aufbau-compiler.wasm && mkdir -p public/assets/aufbau-lsp && cp node_modules/@aufbau/lsp/index.js node_modules/@aufbau/lsp/worker.js node_modules/@aufbau/lsp/lsp.wasm public/assets/aufbau-lsp/ && bun scripts/copy-fonts.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.dom-tests.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply carnap-server-local --local",
    "db:migrate:remote": "wrangler d1 migrations apply carnap-server-local --remote",
    "dev": "bun run build:client && wrangler dev --local",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n": "lingui extract --clean && lingui compile",
    "i18n:check": "bun scripts/i18n-check.ts",
    "i18n:compile": "lingui compile",
    "i18n:coverage": "bun scripts/i18n-check.ts --coverage",
    "i18n:extract": "lingui extract",
    "i18n:baseline": "bun scripts/i18n-pseudo-report.ts --update",
    "i18n:overflow": "bun scripts/a11y-audit.mjs --report --overflow --lang=en-XA",
    "i18n:report": "bun scripts/i18n-pseudo-report.ts",
    "lint": "biome lint .",
    "serve": "bun run build:client && bun src/server/main.ts",
    "lint:check": "biome ci .",
    "test": "bun test",
    "validate": "bun run build:client && bun test && bun run check && bun run lint:check"
  },
  "dependencies": {
    "@aufbau/compiler": "0.0.6",
    "@aufbau/lsp": "0.0.6",
    "@aufbau/verifier": "0.0.6",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@lezer/markdown": "^1.7.2",
    "@libsql/client": "^0.17.4",
    "@lingui/core": "^6.6.0",
    "@mathjax/src": "^4.1.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-math": "^3.1.0",
    "preact": "^10.29.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "^5.20260705.1",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "mdast-util-directive": "^3.1.0",
    "miniflare": "^4.20260701.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  }
}
